# Server Configuration
PORT=3000
NODE_ENV=development

# Priority 1: OpenRouteService (HeiGIT Directions, Distance Matrix & Vroom VRP)
OPENROUTESERVICE_API_KEY="your_ors_token_here"

# Priority 2: Google Gemini AI (Configure via AI Studio Settings > Secrets)
GEMINI_API_KEY="your_gemini_api_key_here"

# Priority 3: OpenStreetMap / Nominatim Configuration
APP_USER_AGENT="LogiMindAI-Hackathon/1.0 (contact@logimind.local)"

# Priority 4: Supabase Database (Optional External Mirror; Primary DB is Cloud SQL PostgreSQL)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# AI Studio Runtime App URL
APP_URL="MY_APP_URL"
